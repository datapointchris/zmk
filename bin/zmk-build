#!/usr/bin/env bash
# zmk-build - ZMK firmware builder
#
# Builds ZMK firmware using per-repo workspaces and config, reading build.yaml
# from the current directory in the standard ZMK GitHub Actions format.

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
if [[ -L "$SCRIPT_PATH" ]]; then
  SCRIPT_PATH="$(python3 -c "import os; print(os.path.realpath('$SCRIPT_PATH'))")"
fi
ZMK_BUILD_APP_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

# The help grammar lives in the dotfiles shell libraries, which is where every
# tool in the fleet gets it from.
if [[ -f "$HOME/.local/shell/formatting.sh" ]]; then
  source "$HOME/.local/shell/formatting.sh"
elif [[ -f "$HOME/dotfiles/configs/common/.local/shell/formatting.sh" ]]; then
  source "$HOME/dotfiles/configs/common/.local/shell/formatting.sh"
else
  echo "zmk-build: cannot find formatting.sh in ~/.local/shell or a dotfiles checkout" >&2
  exit 1
fi

# Sourced if present rather than required, so an installation predating this
# dependency still runs every command it ran before.
BASHSELFUPDATE_LOAD="${XDG_LIB_HOME:-$HOME/.local/lib}/bashselfupdate/load.bash"
if [[ -f "$BASHSELFUPDATE_LOAD" ]]; then
  source "$BASHSELFUPDATE_LOAD"
fi

ZMK_WORKSPACE_BASE="${XDG_DATA_HOME:-$HOME/.local/share}/zmk"
ZMK_WORKSPACE="${ZMK_WORKSPACE:-${ZMK_WORKSPACE_BASE}/$(basename "$(pwd)")}"
DOCKER_IMAGE="zmkfirmware/zmk-build-arm:stable"
BUILD_YAML="build.yaml"
CONFIG_DIR="config"

CONTAINER_WORKSPACE="/workspaces/zmk"
CONTAINER_CONFIG="/workspaces/zmk/config"
CONTAINER_OUTPUT="/workspaces/output"

# Not managed by west — bind-mounted straight into the container, so edits take
# effect without a push/pull cycle.
ZMK_SHARED_DIR="${ZMK_SHARED_DIR:-$(dirname "$(pwd)")/shared}"
CONTAINER_SHARED="$CONTAINER_WORKSPACE/zmk-shared"

get_version() {
  git -C "$ZMK_BUILD_APP_DIR" describe --tags --always 2>/dev/null || echo "dev"
}

show_help() {
  help_header "zmk-build" "ZMK firmware builder."
  help_usage "zmk-build [OPTIONS]"

  help_section "Options"
  help_row "--clean" "" "Remove current repo's workspace and exit"
  help_row "--clean-all" "" "Remove all repo workspaces and exit"
  help_row "--pristine" "" "Force clean rebuild of all targets (ignore cached build artifacts)"
  help_row "--update" "" "Force update west dependencies before building"
  help_row "update" "" "Update zmk-build itself to the latest release"
  help_row "--version" "" "Show the running version"
  help_row "--help" "" "Show this help message"

  help_section "Description"
  help_text \
    "  Builds ZMK firmware using a per-repo workspace under ~/.local/share/zmk/<repo>/" \
    "  and configuration from the current directory. Each repo gets its own isolated" \
    "  workspace, so different ZMK versions don't interfere with each other." \
    "" \
    "  Builds are incremental by default — only changed files are recompiled." \
    "  Use --pristine to force a full rebuild. When multiple targets are defined," \
    "  they are built in parallel." \
    "" \
    "  Reads build.yaml for build targets (standard ZMK GitHub Actions format):" \
    "" \
    "      include:" \
    "        - board: nice_nano//zmk" \
    "          shield: corne_left nice_view_adapter nice_view" \
    "        - board: piantor_pro_bt_left" \
    "          snippet: studio-rpc-usb-uart" \
    "          cmake-args: -DCONFIG_ZMK_STUDIO=y" \
    "" \
    "  Output files are named: artifact-name > shield (first word) > board"

  help_section "build.yaml Fields"
  help_row "board" "" "Required. The board name."
  help_row "shield" "" "Optional. Shield name(s)."
  help_row "snippet" "" "Optional. Zephyr snippet to include."
  help_row "cmake-args" "" "Optional. Extra CMake arguments."
  help_row "artifact-name" "" "Optional. Custom output filename."

  help_section "Requirements"
  help_text \
    "  - Docker" \
    "  - yq (YAML processor)" \
    "  - build.yaml in current directory" \
    "  - config/ directory with keymap and conf files" \
    "  - Sibling shared/ directory (or ZMK_SHARED_DIR env var)"

  help_section "Examples"
  help_row "zmk-build" "" "# Incremental build of all targets"
  help_row "zmk-build --pristine" "" "# Full clean rebuild"
  help_row "zmk-build --update" "" "# Update dependencies and build"

  help_end
}

check_requirements() {
  if [[ ! -f "$BUILD_YAML" ]]; then
    print_error "No $BUILD_YAML found in current directory."
    print_info "Create a build.yaml with your board/shield configuration."
    exit 1
  fi

  if [[ ! -d "$CONFIG_DIR" ]]; then
    print_error "No $CONFIG_DIR/ directory found."
    print_info "Your keymap and conf files should be in config/"
    exit 1
  fi

  if [[ ! -f "$ZMK_SHARED_DIR/zephyr/module.yml" ]]; then
    print_error "Shared behaviors module not found at $ZMK_SHARED_DIR"
    print_info "Expected sibling 'shared/' directory with zephyr/module.yml"
    print_info "Override with ZMK_SHARED_DIR environment variable"
    exit 1
  fi
}

get_target_count() {
  yq '.include | length' "$BUILD_YAML"
}

get_board() {
  local index="$1"
  yq -r ".include[$index].board" "$BUILD_YAML"
}

get_shield() {
  local index="$1"
  yq -r ".include[$index].shield // \"\"" "$BUILD_YAML"
}

get_snippet() {
  local index="$1"
  yq -r ".include[$index].snippet // \"\"" "$BUILD_YAML"
}

get_cmake_args() {
  local index="$1"
  yq -r ".include[$index][\"cmake-args\"] // \"\"" "$BUILD_YAML"
}

get_artifact_name() {
  local index="$1"
  yq -r ".include[$index][\"artifact-name\"] // \"\"" "$BUILD_YAML"
}

# artifact-name > first word of shield > board
get_output_name() {
  local board="$1"
  local shield="$2"
  local artifact_name="$3"

  if [[ -n "$artifact_name" ]]; then
    echo "$artifact_name"
  elif [[ -n "$shield" ]]; then
    echo "${shield%% *}"
  else
    echo "$board"
  fi
}

# A different repo or an updated manifest both need a west update, and neither
# announces itself.
manifest_changed() {
  local current_hash
  current_hash=$(md5sum "$(pwd)/$CONFIG_DIR/west.yml" 2>/dev/null | cut -d' ' -f1)
  local stored_hash=""
  if [[ -f "$ZMK_WORKSPACE/.last_manifest_hash" ]]; then
    stored_hash=$(cat "$ZMK_WORKSPACE/.last_manifest_hash")
  fi
  [[ "$current_hash" != "$stored_hash" ]]
}

save_manifest_hash() {
  md5sum "$(pwd)/$CONFIG_DIR/west.yml" 2>/dev/null | cut -d' ' -f1 >"$ZMK_WORKSPACE/.last_manifest_hash"
}

ensure_workspace() {
  local force_update="$1"

  mkdir -p "$ZMK_WORKSPACE"

  if [[ "$force_update" != "true" ]] && manifest_changed; then
    print_info "Manifest changed — updating west dependencies"
    force_update=true
  fi

  docker run --rm \
    -v "$ZMK_WORKSPACE":"$CONTAINER_WORKSPACE" \
    -v "$(pwd)/$CONFIG_DIR":"$CONTAINER_CONFIG" \
    -w "$CONTAINER_WORKSPACE" \
    "$DOCKER_IMAGE" \
    /bin/bash -c "
      if [ ! -f .west/config ]; then
        echo 'Initializing shared ZMK workspace...'
        west init -l config/
        west update
      elif [ '$force_update' = 'true' ]; then
        echo 'Updating west dependencies...'
        west update
      fi
    "

  save_manifest_hash
}

build_target() {
  local board="$1"
  local shield="$2"
  local output_name="$3"
  local snippet="$4"
  local cmake_args="$5"
  local pristine="$6"
  local build_dir="build/${output_name}"

  local pristine_arg=""
  if [[ "$pristine" == "true" ]]; then
    pristine_arg="-p"
  fi

  local snippet_arg=""
  if [[ -n "$snippet" ]]; then
    snippet_arg="-S $snippet"
  fi

  local shield_arg=""
  if [[ -n "$shield" ]]; then
    shield_arg="-DSHIELD='${shield}'"
  fi

  local board_root_arg=""
  if [[ -d "$(pwd)/boards" ]]; then
    board_root_arg="-DBOARD_ROOT=${CONTAINER_OUTPUT}"
  fi

  # ZMK_EXTRA_MODULES, never ZEPHYR_EXTRA_MODULES: ZMK sets the latter itself to
  # register its own board definitions, and a CLI -D clobbers that list, which
  # surfaces as "No board named 'nice_nano' found".
  docker run --rm \
    -v "$ZMK_WORKSPACE":"$CONTAINER_WORKSPACE" \
    -v "$(pwd)/$CONFIG_DIR":"$CONTAINER_CONFIG" \
    -v "$(pwd)":"$CONTAINER_OUTPUT" \
    -v "$ZMK_SHARED_DIR":"$CONTAINER_SHARED":ro \
    -e "ZMK_CMAKE_ARGS=${cmake_args}" \
    -w "$CONTAINER_WORKSPACE" \
    "$DOCKER_IMAGE" \
    /bin/bash -c "
      export ZEPHYR_BASE=${CONTAINER_WORKSPACE}/zephyr

      west build -s zmk/app -d ${build_dir} -b ${board} ${pristine_arg} ${snippet_arg} -- \
        ${shield_arg} \
        \${ZMK_CMAKE_ARGS} \
        ${board_root_arg} \
        -DZMK_CONFIG=${CONTAINER_CONFIG} \
        -DZephyr_DIR=${CONTAINER_WORKSPACE}/zephyr/share/zephyr-package/cmake \
        -DZMK_EXTRA_MODULES=${CONTAINER_SHARED}

      cp ${build_dir}/zephyr/zmk.uf2 ${CONTAINER_OUTPUT}/${output_name}.uf2
    "
}

do_self_update() {
  if ! declare -F bashselfupdate_update &>/dev/null; then
    print_error "zmk-build update failed: bashselfupdate is not installed"
    print_info "Re-run the installer: bash $ZMK_BUILD_APP_DIR/install.sh"
    exit 1
  fi

  # Checked first because bashselfupdate_update returns the same non-zero for a
  # development checkout, an unreachable remote and a repo with no releases, and
  # "could not reach the remote" is misleading to someone running from a clone.
  if ! bashselfupdate_current_version "$ZMK_BUILD_APP_DIR" >/dev/null 2>&1; then
    print_error "zmk-build update failed: $ZMK_BUILD_APP_DIR is not on a release tag"
    print_info "This is a development checkout. Use git to move it."
    exit 1
  fi

  local moved
  if ! moved=$(bashselfupdate_update "$ZMK_BUILD_APP_DIR"); then
    print_error "zmk-build update failed: could not reach the remote or find a release"
    exit 1
  fi

  if [[ -z "$moved" ]]; then
    print_success "zmk-build already at latest: $(bashselfupdate_describe "$ZMK_BUILD_APP_DIR")"
  else
    print_success "zmk-build updated to $moved"
  fi
}

main() {
  local force_update=false
  local clean_workspace=false
  local clean_all=false
  local pristine=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --clean)
        clean_workspace=true
        shift
        ;;
      --clean-all)
        clean_all=true
        shift
        ;;
      --pristine | -p)
        pristine=true
        shift
        ;;
      --update)
        force_update=true
        shift
        ;;
      update)
        do_self_update
        exit $?
        ;;
      --version | -v)
        echo "zmk-build $(get_version)"
        exit 0
        ;;
      --help | -h)
        show_help
        exit 0
        ;;
      *)
        print_error "Unknown option: $1"
        show_help
        exit 1
        ;;
    esac
  done

  if [[ "$clean_all" == "true" ]]; then
    if [[ -d "$ZMK_WORKSPACE_BASE" ]]; then
      print_warning "Removing all workspaces at $ZMK_WORKSPACE_BASE"
      rm -rf "$ZMK_WORKSPACE_BASE"
      print_success "All workspaces cleared. Next build will reinitialize."
    else
      print_info "No workspaces to clean at $ZMK_WORKSPACE_BASE"
    fi
    exit 0
  fi

  if [[ "$clean_workspace" == "true" ]]; then
    if [[ -d "$ZMK_WORKSPACE" ]]; then
      print_warning "Removing workspace at $ZMK_WORKSPACE"
      rm -rf "$ZMK_WORKSPACE"
      print_success "Workspace cleared. Next build will reinitialize."
    else
      print_info "No workspace to clean at $ZMK_WORKSPACE"
    fi
    exit 0
  fi

  check_requirements

  print_header "ZMK Build" "blue"
  print_info "Workspace: $ZMK_WORKSPACE"
  print_info "Shared: $ZMK_SHARED_DIR"
  print_info "Config: $(pwd)/$CONFIG_DIR"
  [[ "$pristine" == "true" ]] && print_info "Mode: pristine (full rebuild)"
  echo ""

  ensure_workspace "$force_update"

  local total
  total=$(get_target_count)

  if [[ "$total" -eq 0 ]]; then
    print_error "No build targets found in $BUILD_YAML"
    exit 1
  fi

  if ((total > 1)); then
    print_info "Building $total targets in parallel"
  else
    print_info "Building $total target"
  fi
  echo ""

  local start_time=$SECONDS
  local pids=()
  local log_files=()
  local output_names=()

  for ((i = 0; i < total; i++)); do
    local board shield snippet cmake_args artifact_name output_name
    board=$(get_board "$i")
    shield=$(get_shield "$i")
    snippet=$(get_snippet "$i")
    cmake_args=$(get_cmake_args "$i")
    artifact_name=$(get_artifact_name "$i")
    output_name=$(get_output_name "$board" "$shield" "$artifact_name")
    output_names+=("$output_name")

    print_info "Starting: $output_name (board=$board${shield:+ shield=$shield})"

    local log_file
    log_file=$(mktemp "/tmp/zmk-build-${output_name}-XXXX.log")
    log_files+=("$log_file")

    build_target "$board" "$shield" "$output_name" "$snippet" "$cmake_args" "$pristine" >"$log_file" 2>&1 &
    pids+=($!)
  done

  echo ""

  local failed=0
  for ((i = 0; i < ${#pids[@]}; i++)); do
    if wait "${pids[$i]}"; then
      local size
      size=$(du -h "${output_names[$i]}.uf2" 2>/dev/null | cut -f1)
      print_success "${output_names[$i]}.uf2 ($size)"
    else
      print_error "${output_names[$i]} failed — log: ${log_files[$i]}"
      tail -20 "${log_files[$i]}" 2>/dev/null
      failed=1
    fi
  done

  # Logs are kept on failure; that is the only time anyone wants them.
  for ((i = 0; i < ${#log_files[@]}; i++)); do
    if [[ "$failed" -eq 0 ]]; then
      rm -f "${log_files[$i]}"
    fi
  done

  echo ""

  if [[ "$failed" -ne 0 ]]; then
    print_error "Some builds failed"
    exit 1
  fi

  local elapsed=$((SECONDS - start_time))
  local minutes=$((elapsed / 60))
  local seconds=$((elapsed % 60))

  print_header "Build Complete" "green"
  print_success "$total target(s) built in ${minutes}m ${seconds}s"
  echo ""
  ls -lh ./*.uf2 2>/dev/null || true
}

main "$@"
